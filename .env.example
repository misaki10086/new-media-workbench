# Runtime
NODE_ENV=development
PORT=3000
SERVER_PORT=3000
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api

# MySQL (docker-compose.yml uses DB_ROOT_PASSWORD only for container setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=new_media_workbench
DB_USER=new_media
DB_PASSWORD=new_media_password
DB_ROOT_PASSWORD=root_password_change_me
DB_LOGGING=false

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# Platform integration (empty = keep simulated publishing for that platform)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://localhost:3000/api/platform-auth/douyin/callback
XHS_APP_KEY=
XHS_APP_SECRET=
XHS_REDIRECT_URI=http://localhost:3000/api/platform-auth/xiaohongshu/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local uploads (resolved relative to server/ when using the server scripts)
UPLOAD_DIR=uploads

# Simulated publishing worker
PUBLISH_SUCCESS_RATE=0.8
PUBLISH_DELAY_MIN_MS=1000
PUBLISH_DELAY_MAX_MS=3000
PUBLISH_WORKER_CONCURRENCY=3
