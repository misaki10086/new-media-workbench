NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=new_media_workbench
DB_USER=new_media
DB_PASSWORD=new_media_password
DB_LOGGING=false

REDIS_URL=redis://127.0.0.1:6379

# 平台接入（留空则该平台继续使用模拟发布）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://localhost:3000/api/platform-auth/douyin/callback
XHS_APP_KEY=
XHS_APP_SECRET=
XHS_REDIRECT_URI=http://localhost:3000/api/platform-auth/xiaohongshu/callback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UPLOAD_DIR=uploads

PUBLISH_SUCCESS_RATE=0.8
PUBLISH_DELAY_MIN_MS=1000
PUBLISH_DELAY_MAX_MS=3000
PUBLISH_WORKER_CONCURRENCY=3
